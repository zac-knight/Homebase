# Copy to .env. Never commit the real file.
HOMEBASE_DATABASE_URL=postgresql://homebase:homebase@localhost:5432/homebase
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
HOMEBASE_JWT_SECRET=
# OAuth client ID from Google Cloud Console (Web application). Leave empty to disable Google sign in.
HOMEBASE_GOOGLE_CLIENT_ID=
# Email-only sign in for local development. Never enable on a public server.
HOMEBASE_DEV_AUTH=false
# auto | hashing | sentence-transformers
HOMEBASE_EMBEDDER=auto
