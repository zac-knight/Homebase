{
  "manifest_version": 3,
  "name": "Homebase",
  "version": "0.1.0",
  "description": "A clean, searchable new tab page for your bookmarks. Works offline; sync and smart features are opt in.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["bookmarks", "storage", "favicon", "alarms"],
  "optional_permissions": ["history", "scripting", "identity"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
